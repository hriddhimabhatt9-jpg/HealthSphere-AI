# HealthSphere AI — Environment Configuration
# Copy this file to .env and fill in the values

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthsphere

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-healthsphere-2024
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookies
COOKIE_SECRET=dev-cookie-secret-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI / LLM
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Bcrypt
BCRYPT_SALT_ROUNDS=12
